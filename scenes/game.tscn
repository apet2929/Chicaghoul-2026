[node name="EnterAlien5" type="Node" parent="DialogueManager/EnterAlien" index="1" unique_id=719170576]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christian: You are not permitted to investigate that. ", "", "Oh my god. ", "Uh um. ", "", "Ok. Ok. Now listen to me very closely. ", "There is a, um, indicator on your dashboard that reads “Cargo Integrity”. ", "What color is it?", "Red? Oh sh- it’s in th-", "We need to find some way to lure it out of the cargo hold. ", "Can you grab the-"])
durations = Array[float]([6.0, 1.2, 1.2, 1.2, 3.5, 4.2, 7.0, 1.5, 2.0, 3.6, 1.0])
source = ExtResource("16_xbak0")
line_end_callbacks = Array[String](["", "", "", "", "", "", "", "", "", "", ""])
metadata/_custom_type_script = "uid://6btm0m758270"

