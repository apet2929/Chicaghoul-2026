[node name="TutorialLines1" type="Node" parent="DialogueManager" index="0" unique_id=839944764]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christi: <codename>, this is Christi. Great work making that pickup, you’re all superstars, really. Now,", "who’s excited to head back!!", "", "Christi:*clears throat* well, um.", "Christi: Oh! If you didn’t get the message, it’s looking like we’re running a *bit* lower on fuel than expected. So, we’re extending your trip by 2 months to save fuel. So sorry about that.", "Christi: Alexey, could you make that update to the ship trajectory for me?", "Christi: Should be on your dashboard, should be the center-left button with the Snail label on it. Thanks!"])
durations = Array[float]([4.0, 2.0, 5.0, 3.0, 7.0, 5.0, 2.0])
line_end_callbacks = Array[String](["", "", "", "", "show_tutorial_ui", "", ""])
metadata/_custom_type_script = "uid://6btm0m758270"

