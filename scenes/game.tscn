script = ExtResource("4_ca42v")
subtitles = Array[String](["Christi: Should be on your dashboard, should be the center-left button with the Snail label on it. Thanks!"])
durations = Array[float]([2.0])
line_end_callbacks = Array[String](["wait_for_button_press"])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="IncorrectPress" type="Node" parent="DialogueManager/ButtonPressManager" index="1" unique_id=1974328481]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christi: not that button, silly! The one with the snail on it!"])
durations = Array[float]([4.0])
line_end_callbacks = Array[String](["restart"])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="TutorialLines2" type="Node" parent="DialogueManager" index="2" unique_id=403937503]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Allen: You gotta be kidding me, another 2 months before I see my wife and kids?", "Christi: I understand you’re disappointed, guys, and I feel your pain. That’s why I put in a word with Bleemo and we got you a party at the office when you get back! ", "Christi: We’ll have free pizza and soda!", "Allen: Great", ""])
durations = Array[float]([5.0, 5.0, 5.0, 3.0, 5.0])
metadata/_custom_type_script = "uid://6btm0m758270"

