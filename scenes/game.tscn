[node name="TutorialLines1" type="Node" parent="DialogueManager" index="0" unique_id=839944764]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Hello TRA, this is Christian. Great work making that pickup, you’re all superstars, really. Now,", "who’s excited to head back!!", "", "Christian:*clears throat* well, um.", "Christian: Oh! If you didn’t get the message, it’s looking like we’re running a *bit* lower on fuel than expected. So, we’re extending your trip by 2 months to save fuel. So sorry about that.", "Christian: Alexey, could you make that update to the ship trajectory for me?"])
durations = Array[float]([6.5, 2.0, 3.5, 3.0, 7.0, 5.0])
source = ExtResource("6_q8j3a")
line_end_callbacks = Array[String](["", "", "", "", "show_tutorial_ui", ""])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="ButtonPressManager" type="Node" parent="DialogueManager" index="1" unique_id=1695114365]
script = ExtResource("5_qnb83")
metadata/_custom_type_script = "uid://b4wi2imswuwib"

[node name="ChristiLines1" type="Node" parent="DialogueManager/ButtonPressManager" index="0" unique_id=375388012]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christian: Should be on your dashboard. Just press that RIGHT** arrow twice and hit confirm. Thanks!"])
durations = Array[float]([8.4])
source = ExtResource("9_7ixpq")
line_end_callbacks = Array[String](["wait_for_tutorial_submit"])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="IncorrectPress" type="Node" parent="DialogueManager/ButtonPressManager" index="1" unique_id=1974328481]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christian: Yeah we should be arriving by October now..."])
durations = Array[float]([4.0])
source = ExtResource("10_ms3bu")
line_end_callbacks = Array[String](["restart"])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="TutorialLines3" type="Node" parent="DialogueManager" index="2" unique_id=403937503]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Allen: You gotta be kidding me, another 2 months before I see my wife and kids?"])
durations = Array[float]([5.5])
source = ExtResource("11_7ixpq")
line_end_callbacks = Array[String]([""])
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="TutorialLines4" type="Node" parent="DialogueManager" index="3" unique_id=427098181]
script = ExtResource("4_ca42v")
subtitles = Array[String](["Christian: I understand you’re disappointed, guys, and I feel your pain. ", "Christian: That’s why I put in a word with Bleemo and we got you a party at the office when you get back! ", "Christian: We’ll have free pizza and soda!"])
durations = Array[float]([4.4, 5.0, 3.0])
source = ExtResource("12_n8ral")
line_end_callbacks = Array[String](["", "", ""])
metadata/_custom_type_script = "uid://6btm0m758270"

