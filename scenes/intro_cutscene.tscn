on_end_callback_fn_name = "show_title_card"
metadata/_custom_type_script = "uid://6btm0m758270"

[node name="Dialogue5" type="Node" parent="XROrigin3D/IntroCutsceneManager" index="5" unique_id=2032587346]
script = ExtResource("3_k5ksj")
subtitle = "Allen: Nothing good ever comes from space."
duration = 5.0
metadata/_custom_type_script = "uid://6btm0m758270"

