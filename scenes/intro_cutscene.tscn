[node name="Dialogue4" type="Node" parent="XROrigin3D/IntroCutsceneManager" index="4" unique_id=636055476]
script = ExtResource("3_k5ksj")
subtitle = "Allen: This your first rodeo kid? Space gigs are the worst. All that waiting, nothing to do but play cards, your body decaying with every passing day. Gets old fast."
