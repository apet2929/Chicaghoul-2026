[sub_resource type="GDScript" id="GDScript_ljnj7"]
script/source = "extends XRController3D

static var LEFT_HAND_MESH_NAME = \"Hand_Left\"
static var RIGHT_HAND_MESH_NAME = \"Hand_Right\"

@onready var mesh_library: MeshLibrary = preload(\"res://assets/VR_Assets.dae\")
@export var is_left = false
var mesh_inst

func _ready() -> void:
	var mesh_idx
	if is_left:
		mesh_idx = mesh_library.find_item_by_name(LEFT_HAND_MESH_NAME)
	else:
		mesh_idx = mesh_library.find_item_by_name(RIGHT_HAND_MESH_NAME)
	
	var hand_mesh = mesh_library.get_item_mesh(mesh_idx)
	mesh_inst = MeshInstance3D.new()
	mesh_inst.mesh = hand_mesh
		
"

